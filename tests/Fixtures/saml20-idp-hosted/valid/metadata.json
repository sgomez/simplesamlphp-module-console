{
  "host": "__DEFAULT__",
  "auth": "example-userpass",
  "key": {
    "privatekey": "idp.key",
    "privatekey_pass": "secret",
    "certificate": {
      "source": "pasted",
      "pem": "@PEM@"
    },
    "key_name": "current"
  },
  "https_certificate": {
    "source": "file",
    "file": "https.crt"
  },
  "SingleSignOnService": {
    "Bindings": [
      "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect",
      "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
    ]
  },
  "logouttype": "iframe",
  "OrganizationName": {
    "en": "Example"
  },
  "OrganizationURL": {
    "en": "https://example.org"
  },
  "metadata.sign.enable": true,
  "metadata.sign.algorithm": "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256",
  "metadata_sign_key": {
    "privatekey": "metadata.key",
    "certificate": {
      "source": "file",
      "file": "metadata.crt"
    }
  }
}
