{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL database (sqlauth:SQL2)",
  "type": "object",
  "additionalProperties": false,
  "x-groups": [
    {"title": "Databases", "properties": ["databases"]},
    {"title": "Authentication queries", "properties": ["auth_queries"]},
    {"title": "Attribute queries", "properties": ["attr_queries"]}
  ],
  "required": ["databases", "auth_queries"],
  "properties": {
    "databases": {
      "title": "Databases",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "database",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dsn", "username", "password"],
        "properties": {
          "name": {"title": "Name", "type": "string", "pattern": "^[A-Za-z0-9_]+$"},
          "dsn": {"title": "DSN", "type": "string", "examples": ["pgsql:host=db.example.org;dbname=users"]},
          "username": {"title": "Username", "type": "string"},
          "password": {"title": "Password", "type": "string", "x-sensitive": true}
        }
      }
    },
    "auth_queries": {
      "title": "Authentication queries",
      "description": "Tried in order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "query",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "database", "query"],
        "properties": {
          "name": {"title": "Name", "type": "string", "pattern": "^[A-Za-z0-9_]+$"},
          "database": {"title": "Database", "type": "string"},
          "query": {"title": "Query", "description": "Receives :username and :password.", "type": "string", "x-widget": "textarea"},
          "username_regex": {"title": "Username regex", "description": "The query is skipped when the username does not match.", "type": "string", "examples": ["/@example\\.org$/"]},
          "password_verify_hash_column": {"title": "Hash column", "description": "Switches to password_verify() against this column.", "type": "string"}
        }
      }
    },
    "attr_queries": {
      "title": "Attribute queries",
      "type": "array",
      "items": {
        "title": "query",
        "type": "object",
        "additionalProperties": false,
        "required": ["database", "query"],
        "properties": {
          "database": {"title": "Database", "type": "string"},
          "query": {"title": "Query", "type": "string", "x-widget": "textarea"},
          "only_for_auth": {"title": "Only after these authentication queries", "description": "One name per line.", "type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
