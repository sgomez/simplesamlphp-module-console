{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inline test users (exampleauth:UserPass)",
  "type": "object",
  "additionalProperties": false,
  "x-groups": [{"title": "Users", "properties": ["users"]}],
  "required": ["users"],
  "properties": {
    "users": {
      "title": "Users",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "user",
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "properties": {
          "username": {"title": "Username", "type": "string", "pattern": "^[^:]+$"},
          "password": {"title": "Password", "type": "string", "x-sensitive": true},
          "attributes": {
            "title": "Attributes",
            "type": "array",
            "items": {
              "title": "attribute",
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "values"],
              "properties": {
                "name": {"title": "Name", "type": "string"},
                "values": {"title": "Values", "description": "One per line.", "type": "array", "items": {"type": "string"}, "minItems": 1}
              }
            }
          }
        }
      }
    }
  }
}
