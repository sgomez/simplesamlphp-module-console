{% extends "@console/shell.twig" %}
{% set active = 'service-providers' %}

{% block title %}Service providers{% endblock %}

{% block breadcrumb %}<a class="crumb" href="{{ consoleUrl }}">Console</a><span aria-hidden="true" class="faint">/</span><span aria-current="page" class="crumb-current">Service providers</span>{% endblock %}

{% block content %}
<div class="page-head">
  <div class="title"><h1 class="h1">Service providers</h1><span class="mono faint">saml20-sp-remote</span></div>
  <a class="btn btn-primary" href="{{ newUrl }}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 2v10M2 7h10"/></svg>Add</a>
</div>

<form method="get" class="toolbar" action="{{ listUrl }}" role="search">
  <label class="search"><span class="sr-only">Search by name or entity ID</span><input class="input" type="search" name="q" value="{{ query }}" placeholder="Search by name or entity ID"></label>
</form>

{% if rows is empty %}
<div class="card empty">
  {% if query %}
  <h2 class="h2">No service provider matches “{{ query }}”</h2>
  <a class="btn btn-secondary" href="{{ listUrl }}">Clear search</a>
  {% else %}
  <h2 class="h2">No service providers yet</h2>
  {% endif %}
</div>
{% else %}
<div class="card card-list">
  {% for row in rows %}
  {% set main %}
    <div class="row-main">
      {% if row.name %}<span class="row-name">{{ row.name }}</span>{% endif %}
      <span class="eid">{% set cut = max(0, row.entityId|length - 16) %}<span class="eid-a">{{ row.entityId|slice(0, cut) }}</span><span class="eid-b">{{ row.entityId|slice(cut) }}</span></span>
    </div>
    {% if row.state or row.labels or row.error %}
    <div class="row-note notes">
      {% if row.state == 'Unreadable' %}<span class="status s-danger"><span class="dot dot-full" aria-hidden="true"></span>Unreadable</span>
      {% elseif row.state == 'Modified' %}<span class="status s-pending"><span class="dot dot-half" aria-hidden="true"></span>Modified</span>
      {% elseif row.state == 'Up to date' %}<span class="status s-live"><span class="dot dot-full" aria-hidden="true"></span>Up to date</span>
      {% elseif row.state %}<span class="status s-pending"><span class="dot" aria-hidden="true"></span>{{ row.state }}</span>{% endif %}
      {% for label in row.labels %}
      {% if label.kind is defined and label.kind == 'warning' %}<span class="status s-warn" title="{{ label.title }}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.2 15.2 14H.8L8 1.2zm-.9 4.6v4h1.8v-4H7.1zm0 5.2v1.7h1.8V11H7.1z"/></svg>{{ label.text }}</span>
      {% else %}<span class="chip"{% if label.title %} title="{{ label.title }}"{% endif %}>{{ label.text }}</span>{% endif %}
      {% endfor %}
      {% if row.error %}<span class="small s-danger">{{ row.error }}</span>{% endif %}
    </div>
    {% endif %}
  {% endset %}
  {% if row.editUrl %}
  <a class="row row-wrap" href="{{ row.editUrl }}" data-entity="{{ row.entityId }}">
    {{ main }}
    <svg class="row-end" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 3l5 5-5 5"/></svg>
  </a>
  {% else %}
  <div class="row row-wrap" data-entity="{{ row.entityId }}">
    {{ main }}
    <form method="post" action="{{ deleteUrl }}">
      <input type="hidden" name="_token" value="{{ csrfToken }}">
      <input type="hidden" name="entityid" value="{{ row.entityId }}">
      <button type="submit" class="btn btn-danger btn-sm" data-confirm="Delete {{ row.entityId }}? This removes the service provider from the Console.">Delete</button>
    </form>
  </div>
  {% endif %}
  {% endfor %}
</div>
{% endif %}

{% if rows is not empty %}
<nav class="pager" aria-label="Pagination">
  <span class="small muted pager-total" data-total>{{ total }} service provider{{ total == 1 ? '' : 's' }}</span>
  {% if pages > 1 %}
  {% if previousUrl %}<a class="btn btn-secondary btn-sm" href="{{ previousUrl }}">Previous</a>{% else %}<span class="btn btn-secondary btn-sm is-disabled" aria-disabled="true">Previous</span>{% endif %}
  <span class="small muted">Page {{ page }} of {{ pages }}</span>
  {% if nextUrl %}<a class="btn btn-secondary btn-sm" href="{{ nextUrl }}">Next</a>{% else %}<span class="btn btn-secondary btn-sm is-disabled" aria-disabled="true">Next</span>{% endif %}
  {% endif %}
</nav>
{% endif %}
{% endblock %}
