{% extends "@console/shell.twig" %}
{% set active = 'service-providers' %}

{% block title %}{{ isNew ? 'Add service provider' : entityId }}{% endblock %}

{% block breadcrumb %}<a class="crumb" href="{{ consoleUrl }}">Console</a><span aria-hidden="true" class="faint">/</span><a class="crumb" href="{{ listUrl }}">Service providers</a><span aria-hidden="true" class="faint">/</span><span aria-current="page" class="crumb-current">{{ isNew ? 'Add' : entityId }}</span>{% endblock %}

{% block page_class %}page-wide{% endblock %}

{% block content %}
<div class="page-head">
  <div class="title">
    <h1 class="h1">{{ name|default(isNew ? 'New service provider' : entityId) }}</h1>
    <span class="small muted">Service provider</span><span class="mono faint">{{ set }}</span>
  </div>
</div>
{% if not isNew and name is defined and name %}<span class="eid">{{ entityId }}</span>{% endif %}

{% if errors %}
<div class="callout callout-error" data-errors aria-label="Errors">
  <svg class="ic ic-error" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm-.9 3.5h1.8v5H7.1v-5zm0 6.2h1.8v1.8H7.1v-1.8z"/></svg>
  <div class="callout-body"><span class="callout-title">{{ errors|length == 1 ? '1 error' : errors|length ~ ' errors' }}</span></div>
</div>
<ul class="card card-list plain">
  {% for error in errors %}
  <li class="row issue"{% if error.line %} data-error-line="{{ error.line }}"{% endif %}>
    {% if error.line %}<a class="link mono issue-at" href="#line-{{ error.line }}">Line {{ error.line }}{% if error.column %}, column {{ error.column }}{% endif %}</a>{% endif %}
    <span class="msg-error"><span class="strong">Error</span><span>{{ error.message }}</span></span>
  </li>
  {% endfor %}
</ul>
{% endif %}

{% if warnings is defined and warnings %}
<ul class="card card-list plain" data-warnings aria-label="Warnings">
  {% for warning in warnings %}
  <li class="row issue"><span class="msg-warning"><span class="strong">{{ warning.label }}</span><span>{{ warning.message }}</span></span></li>
  {% endfor %}
</ul>
{% endif %}

<form method="post" action="{{ saveUrl }}" id="entity-form" class="split-main" data-entity-form>
  <input type="hidden" name="_token" value="{{ csrfToken }}">
  {% if isNew %}
  <div class="field">
    <label class="label" for="entityid">Entity ID</label>
    <input class="input mono{% if identityErrors %} is-error{% endif %}" type="text" id="entityid" name="entityid" value="{{ entityId }}" spellcheck="false" autocomplete="off" placeholder="Taken from the text when empty">
    {% for message in identityErrors %}
    <p class="msg-error" data-field-error="entityid">{{ message }}{% if existingUrl is defined %} <a class="link" href="{{ existingUrl }}">Open the existing one</a>{% endif %}</p>
    {% endfor %}
  </div>
  {% else %}
  <input type="hidden" name="entityid" value="{{ entityId }}">
  <input type="hidden" name="version" value="{{ version }}">
  {% endif %}

  <div class="card card-list">
    <div class="ed">
      <div class="ed-gutter" data-gutter aria-hidden="true">
        {% for n in 1..lineCount %}<div class="ed-ln{% if n in errorLines %} err{% endif %}" id="line-{{ n }}"><span>{% if n in errorLines %}×{% endif %}</span><span>{{ n }}</span></div>{% endfor %}
      </div>
      <div class="ed-body">
        <div class="ed-bg" aria-hidden="true">{% for n in 1..lineCount %}<div{% if n in errorLines %} class="err"{% endif %}></div>{% endfor %}</div>
        <textarea name="php" id="php-editor" class="ed-text" data-editor rows="{{ max(lineCount, 12) }}" spellcheck="false" wrap="off" aria-label="PHP">{{ text }}</textarea>
      </div>
    </div>
  </div>
</form>
{% endblock %}

{% block after_page %}
<div class="save-bar">
  <button type="submit" form="entity-form" class="btn btn-primary">Save</button>
</div>
{% endblock %}
