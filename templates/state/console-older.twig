{% extends "@console/shell.twig" %}

{% block title %}Console older than the database{% endblock %}

{% block breadcrumb %}<a class="crumb" href="{{ consoleUrl }}">Console</a><span aria-hidden="true" class="faint">/</span><span aria-current="page" class="crumb-current">{{ block('title') }}</span>{% endblock %}

{% block page_class %}page-narrow{% endblock %}

{% block content %}
<section class="card empty state-page" data-state="console-older">
  <h1 class="h1">Console older than the database</h1>
  <p class="muted">This node's Console knows schema version {{ status.known }}, but the database holds schema version {{ status.highest }}.</p>
  <p class="muted">Please update the package on this node. The Console stays blocked until then.</p>
</section>
{% endblock %}
