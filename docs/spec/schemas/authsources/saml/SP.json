{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAML service provider (saml:SP)",
  "type": "object",
  "additionalProperties": false,
  "x-groups": [
    {"title": "Identity and IdP selection", "properties": ["entityID", "idp", "discoURL", "RelayState", "enable_unsolicited", "RequestInitiation", "proxymode.passAuthnContextClassRef"]},
    {"title": "Authentication request", "properties": ["ForceAuthn", "IsPassive", "ProtocolBinding", "AssertionConsumerServiceIndex", "AttributeConsumingServiceIndex", "AuthnContextClassRef", "AuthnContextComparison", "NameIDPolicy", "IDPList", "ProxyCount", "disable_scoping", "ProviderName"]},
    {"title": "Signing and encryption", "properties": ["sign.authnrequest", "sign.logout", "redirect.sign", "validate.logout", "redirect.validate", "signature.algorithm", "WantAssertionsSigned", "assertion.encryption", "nameid.encryption", "encryption.blacklisted-algorithms", "saml20.hok.assertion"]},
    {"title": "Keys", "properties": ["key", "next_key"]},
    {"title": "Endpoints", "properties": ["AssertionConsumerService", "acs.Bindings", "SingleLogoutServiceBinding", "SingleLogoutServiceLocation"]},
    {"title": "Published metadata", "properties": ["name", "description", "attributes", "attributes.required", "attributes.NameFormat", "attributes.index", "attributes.isDefault", "OrganizationName", "OrganizationDisplayName", "OrganizationURL", "contacts", "EntityAttributes", "UIInfo", "RegistrationInfo"]},
    {"title": "Processing", "properties": ["authproc"]}
  ],
  "required": ["entityID"],
  "properties": {
    "entityID": {
      "title": "Entity ID",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {"const": "https://myapp.example.org/"},
      "examples": ["https://sp.example.org/metadata"]
    },
    "idp": {
      "title": "Identity provider",
      "description": "Entity ID of the only IdP this SP uses. Not set: the user chooses through discovery.",
      "type": "string",
      "minLength": 1
    },
    "discoURL": {
      "title": "Discovery service URL",
      "description": "Not set: idpdisco.url.saml20 from config.php, then the built-in discovery page.",
      "type": "string",
      "minLength": 1
    },
    "RelayState": {
      "title": "Landing address after IdP-initiated login",
      "type": "string",
      "minLength": 1,
      "default": "/"
    },
    "enable_unsolicited": {"title": "Accept unsolicited responses", "type": "boolean", "default": true},
    "RequestInitiation": {"title": "Publish a request initiator endpoint", "type": "boolean", "default": false},
    "proxymode.passAuthnContextClassRef": {
      "title": "Pass the authentication context to the IdP when proxying",
      "type": "boolean",
      "default": false
    },
    "ForceAuthn": {"title": "Force re-authentication", "type": "boolean", "default": false},
    "IsPassive": {"title": "Passive authentication", "type": "boolean", "default": false},
    "ProtocolBinding": {
      "title": "Binding requested for the response",
      "type": "string",
      "enum": [
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST",
        "urn:oasis:names:tc:SAML:2.0:profiles:holder-of-key:SSO:browser",
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Artifact"
      ],
      "default": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
    },
    "AssertionConsumerServiceIndex": {"title": "Assertion consumer service index", "type": "integer", "minimum": 0},
    "AttributeConsumingServiceIndex": {"title": "Attribute consuming service index", "type": "integer", "minimum": 0},
    "AuthnContextClassRef": {
      "title": "Requested authentication context classes",
      "description": "One per line.",
      "$ref": "../../common.json#/$defs/stringList",
      "minItems": 1
    },
    "AuthnContextComparison": {
      "title": "Authentication context comparison",
      "description": "Used only together with the requested authentication context classes.",
      "type": "string",
      "enum": ["exact", "minimum", "maximum", "better"],
      "default": "exact"
    },
    "NameIDPolicy": {
      "title": "NameID policy",
      "description": "With every field empty, the request carries no NameIDPolicy element. Not set: transient, with AllowCreate on.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Format": {
          "title": "Format",
          "type": "string",
          "minLength": 1,
          "examples": ["urn:oasis:names:tc:SAML:2.0:nameid-format:persistent"]
        },
        "AllowCreate": {"title": "Allow the IdP to create an identifier", "type": "boolean"},
        "SPNameQualifier": {"title": "SP name qualifier", "type": "string", "minLength": 1}
      }
    },
    "IDPList": {
      "title": "IdP list sent in the scoping element",
      "description": "One entity ID per line.",
      "$ref": "../../common.json#/$defs/stringList"
    },
    "ProxyCount": {"title": "Proxy count", "type": "integer", "minimum": 0},
    "disable_scoping": {"title": "Send no scoping element", "type": "boolean", "default": false},
    "ProviderName": {"title": "Provider name", "type": "string", "minLength": 1},
    "sign.authnrequest": {
      "title": "Sign authentication requests",
      "description": "Wins over the value in the IdP's metadata. Not set in either: the value of Sign redirect messages.",
      "type": "boolean"
    },
    "sign.logout": {
      "title": "Sign logout messages",
      "description": "Wins over the value in the IdP's metadata. Not set in either: the value of Sign redirect messages.",
      "type": "boolean"
    },
    "redirect.sign": {"title": "Sign redirect messages", "type": "boolean", "default": false},
    "validate.logout": {
      "title": "Require signed logout messages",
      "description": "Not set here or in the IdP's metadata: the value of Validate redirect messages.",
      "type": "boolean"
    },
    "redirect.validate": {"title": "Validate redirect messages", "type": "boolean", "default": false},
    "signature.algorithm": {
      "title": "Signature algorithm",
      "$ref": "../../common.json#/$defs/signatureAlgorithm",
      "default": "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"
    },
    "WantAssertionsSigned": {"title": "Announce that assertions must be signed", "type": "boolean"},
    "assertion.encryption": {"title": "Require encrypted assertions", "type": "boolean", "default": false},
    "nameid.encryption": {"title": "Encrypt the NameID in logout messages", "type": "boolean", "default": false},
    "encryption.blacklisted-algorithms": {
      "title": "Refused encryption algorithms",
      "description": "One per line. Not set: RSA 1.5 is refused.",
      "$ref": "../../common.json#/$defs/stringList"
    },
    "saml20.hok.assertion": {"title": "Holder-of-key profile", "type": "boolean", "default": false},
    "key": {
      "title": "Key",
      "description": "The key pair this SP signs and decrypts with.",
      "$ref": "../../common.json#/$defs/keySlot"
    },
    "next_key": {
      "title": "Next key",
      "description": "Published next to the current key so that IdPs learn it before it is promoted.",
      "$ref": "../../common.json#/$defs/keySlot"
    },
    "AssertionConsumerService": {
      "title": "Assertion consumer services",
      "description": "Published as given, instead of the endpoints the module generates.",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "endpoint",
        "type": "object",
        "additionalProperties": false,
        "required": ["Binding", "Location"],
        "properties": {
          "Binding": {"title": "Binding", "type": "string", "minLength": 1},
          "Location": {
            "title": "Location",
            "type": "string",
            "pattern": "^https?://",
            "$error": {"pattern": "A location is an absolute http or https URL."}
          },
          "index": {"title": "Index", "type": "integer", "minimum": 0},
          "isDefault": {"title": "Default", "type": "boolean"}
        }
      }
    },
    "acs.Bindings": {
      "title": "Bindings of the generated assertion consumer services",
      "description": "Not set: HTTP-POST and HTTP-Artifact, plus holder-of-key when that is the requested binding.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST",
          "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Artifact",
          "urn:oasis:names:tc:SAML:2.0:profiles:holder-of-key:SSO:browser"
        ]
      }
    },
    "SingleLogoutServiceBinding": {
      "title": "Bindings of the single logout service",
      "description": "One per line. Not set: HTTP-Redirect and SOAP. SOAP is published only with an SQL session store.",
      "$ref": "../../common.json#/$defs/stringList"
    },
    "SingleLogoutServiceLocation": {
      "title": "Single logout service location",
      "description": "Not set: the module's own endpoint.",
      "type": "string",
      "pattern": "^https?://",
      "$error": {"pattern": "A location is an absolute http or https URL."}
    },
    "name": {
      "title": "Name",
      "description": "Published only when requested attributes are listed.",
      "$ref": "../../common.json#/$defs/languageMap"
    },
    "description": {
      "title": "Description",
      "description": "Published only when requested attributes are listed.",
      "$ref": "../../common.json#/$defs/languageMap"
    },
    "attributes": {
      "title": "Requested attributes",
      "type": "array",
      "items": {
        "title": "attribute",
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"title": "Name", "type": "string", "minLength": 1, "examples": ["urn:oid:0.9.2342.19200300.100.1.3"]},
          "friendlyName": {"title": "Friendly name", "type": "string", "minLength": 1, "examples": ["mail"]}
        }
      }
    },
    "attributes.required": {
      "title": "Required attributes",
      "description": "One name per line.",
      "$ref": "../../common.json#/$defs/stringList"
    },
    "attributes.NameFormat": {
      "title": "Attribute name format",
      "type": "string",
      "minLength": 1,
      "examples": ["urn:oasis:names:tc:SAML:2.0:attrname-format:uri"]
    },
    "attributes.index": {"title": "Attribute consuming service index", "type": "integer", "minimum": 0},
    "attributes.isDefault": {"title": "Default attribute consuming service", "type": "boolean"},
    "OrganizationName": {"title": "Organization name", "$ref": "../../common.json#/$defs/languageMap"},
    "OrganizationDisplayName": {
      "title": "Organization display name",
      "description": "Not set: the organization name. Read only when the organization name is set.",
      "$ref": "../../common.json#/$defs/languageMap"
    },
    "OrganizationURL": {
      "title": "Organization URL",
      "description": "Mandatory when the organization name is set, and read only then.",
      "$ref": "../../common.json#/$defs/languageMap"
    },
    "contacts": {
      "title": "Contacts",
      "description": "The technical contact of config.php is added to these.",
      "$ref": "../../common.json#/$defs/contacts"
    },
    "EntityAttributes": {"title": "Entity attributes", "$ref": "../../common.json#/$defs/EntityAttributes"},
    "UIInfo": {"title": "User interface information", "$ref": "../../common.json#/$defs/UIInfo"},
    "RegistrationInfo": {"title": "Registration information", "$ref": "../../common.json#/$defs/RegistrationInfo"},
    "authproc": {"title": "Processing filters", "$ref": "../../common.json#/$defs/authproc"}
  }
}
