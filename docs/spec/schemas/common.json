{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shapes shared by the authsource and entity schemas",
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "languageMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$",
        "$error": {"pattern": "A language is a code such as en, es or pt-BR."}
      },
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "languageListMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$",
        "$error": {"pattern": "A language is a code such as en, es or pt-BR."}
      },
      "additionalProperties": {"$ref": "#/$defs/stringList", "minItems": 1}
    },
    "signatureAlgorithm": {
      "type": "string",
      "enum": [
        "http://www.w3.org/2000/09/xmldsig#rsa-sha1",
        "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256",
        "http://www.w3.org/2001/04/xmldsig-more#rsa-sha384",
        "http://www.w3.org/2001/04/xmldsig-more#rsa-sha512"
      ]
    },
    "authproc": {
      "description": "Processing filters. Each row holds a priority and the filter's configuration; only the class is checked.",
      "type": "array",
      "x-widget": "textarea",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "filter"],
        "properties": {
          "priority": {"type": "integer"},
          "filter": {
            "type": "object",
            "required": ["class"],
            "properties": {
              "class": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "examples": [[{"priority": 50, "filter": {"class": "core:AttributeMap", "0": "oid2name"}}]]
    },
    "certificate": {
      "title": "Certificate",
      "type": "object",
      "x-key-reference": "certificate",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "title": "Where the certificate comes from",
          "description": "Pasted: the Console holds it. File: every node provides it.",
          "type": "string",
          "enum": ["pasted", "file"],
          "x-widget": "radio"
        },
        "pem": {
          "title": "Certificate in PEM",
          "type": "string",
          "minLength": 1,
          "x-widget": "textarea",
          "x-when": {"source": ["pasted"]}
        },
        "file": {
          "title": "Certificate file",
          "description": "A name relative to the node's certdir, or an absolute path.",
          "type": "string",
          "minLength": 1,
          "examples": ["sp.crt"],
          "x-when": {"source": ["file"]}
        }
      },
      "if": {"properties": {"source": {"const": "pasted"}}, "required": ["source"]},
      "then": {"required": ["pem"]},
      "else": {"required": ["file"]}
    },
    "keySlot": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "dependentRequired": {
        "privatekey": ["certificate"],
        "certificate": ["privatekey"]
      },
      "properties": {
        "privatekey": {
          "title": "Private key file",
          "description": "A name relative to the node's certdir, or an absolute path. Every node provides the file; the Console never holds a private key.",
          "type": "string",
          "minLength": 1,
          "x-key-reference": "private-key",
          "examples": ["/run/secrets/sp.key"]
        },
        "privatekey_pass": {
          "title": "Private key passphrase",
          "type": "string",
          "x-sensitive": true
        },
        "certificate": {"$ref": "#/$defs/certificate"},
        "key_name": {
          "title": "Key name",
          "description": "Published as the KeyName of the certificate.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "title": "contact",
        "type": "object",
        "additionalProperties": false,
        "required": ["contactType"],
        "properties": {
          "contactType": {
            "title": "Type",
            "type": "string",
            "enum": ["technical", "support", "administrative", "billing", "other"]
          },
          "givenName": {"title": "Given name", "type": "string", "minLength": 1},
          "surName": {"title": "Surname", "type": "string", "minLength": 1},
          "company": {"title": "Company", "type": "string", "minLength": 1},
          "emailAddress": {
            "title": "Email addresses",
            "description": "One per line.",
            "$ref": "#/$defs/stringList",
            "minItems": 1
          },
          "telephoneNumber": {
            "title": "Telephone numbers",
            "description": "One per line.",
            "$ref": "#/$defs/stringList",
            "minItems": 1
          },
          "attributes": {
            "title": "XML attributes",
            "type": "array",
            "minItems": 1,
            "items": {
              "title": "attribute",
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {"title": "Name", "type": "string", "minLength": 1},
                "value": {"title": "Value", "type": "string"}
              }
            }
          }
        }
      }
    },
    "EntityAttributes": {
      "type": "array",
      "items": {
        "title": "entity attribute",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "values"],
        "properties": {
          "name": {
            "title": "Name",
            "description": "Optionally prefixed with its name format in braces.",
            "type": "string",
            "minLength": 1,
            "examples": ["http://macedir.org/entity-category"]
          },
          "values": {
            "title": "Values",
            "description": "One per line.",
            "$ref": "#/$defs/stringList",
            "minItems": 1
          }
        }
      }
    },
    "UIInfo": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "DisplayName": {"title": "Display name", "$ref": "#/$defs/languageMap"},
        "Description": {"title": "Description", "$ref": "#/$defs/languageMap"},
        "InformationURL": {"title": "Information URL", "$ref": "#/$defs/languageMap"},
        "PrivacyStatementURL": {"title": "Privacy statement URL", "$ref": "#/$defs/languageMap"},
        "Keywords": {"title": "Keywords", "$ref": "#/$defs/languageListMap"},
        "Logo": {
          "title": "Logos",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "logo",
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "width", "height"],
            "properties": {
              "url": {"title": "URL", "type": "string", "minLength": 1},
              "width": {"title": "Width", "type": "integer", "minimum": 1},
              "height": {"title": "Height", "type": "integer", "minimum": 1},
              "lang": {"title": "Language", "type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "RegistrationInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority"],
      "properties": {
        "authority": {"title": "Registration authority", "type": "string", "minLength": 1},
        "instant": {
          "title": "Registration instant",
          "type": "string",
          "format": "date-time",
          "examples": ["2026-11-24T10:15:00Z"]
        },
        "policies": {"title": "Registration policies", "$ref": "#/$defs/languageMap"}
      }
    },
    "DiscoHints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "IPHint": {"title": "IP blocks", "description": "One CIDR block per line.", "$ref": "#/$defs/stringList", "minItems": 1},
        "DomainHint": {"title": "Domains", "description": "One per line.", "$ref": "#/$defs/stringList", "minItems": 1},
        "GeolocationHint": {"title": "Geolocations", "description": "One geo: URI per line.", "$ref": "#/$defs/stringList", "minItems": 1}
      }
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "x-literal": true,
      "pattern": "^https?://[^\\s/?#]+[^\\s]*$",
      "$error": {"pattern": "An absolute http or https URL."}
    },
    "binding": {
      "title": "Binding",
      "type": "string",
      "enum": [
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect",
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST",
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Artifact",
        "urn:oasis:names:tc:SAML:2.0:bindings:SOAP",
        "urn:oasis:names:tc:SAML:2.0:bindings:PAOS",
        "urn:oasis:names:tc:SAML:2.0:profiles:holder-of-key:SSO:browser"
      ]
    },
    "remoteBinding": {
      "title": "Binding",
      "description": "Any absolute URI. Core skips an endpoint whose binding it does not implement.",
      "type": "string",
      "x-literal": true,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
      "$error": {"pattern": "An absolute URI."},
      "examples": [
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect",
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST",
        "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Artifact",
        "urn:oasis:names:tc:SAML:2.0:bindings:SOAP",
        "urn:oasis:names:tc:SAML:2.0:bindings:PAOS",
        "urn:oasis:names:tc:SAML:2.0:profiles:holder-of-key:SSO:browser"
      ]
    },
    "endpoint": {
      "title": "endpoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["Binding", "Location"],
      "properties": {
        "Binding": {"$ref": "#/$defs/remoteBinding"},
        "Location": {"title": "Location", "$ref": "#/$defs/url"},
        "ResponseLocation": {
          "title": "Response location",
          "description": "Not set: responses go to the location.",
          "$ref": "#/$defs/url"
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "indexedEndpoint": {
      "title": "endpoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["Binding", "Location"],
      "properties": {
        "Binding": {"$ref": "#/$defs/remoteBinding"},
        "Location": {"title": "Location", "$ref": "#/$defs/url"},
        "index": {"title": "Index", "type": "integer", "minimum": 0},
        "isDefault": {"title": "Default", "type": "boolean"}
      }
    },
    "indexedEndpoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/indexedEndpoint"}
    },
    "hostedEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Bindings"],
      "properties": {
        "Location": {
          "title": "Location",
          "description": "Not set: SimpleSAMLphp derives it from its base URL. Set it only behind a proxy that rewrites the address.",
          "$ref": "#/$defs/url"
        },
        "Bindings": {
          "title": "Bindings",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "remoteCertificates": {
      "title": "Certificates",
      "description": "Held by the Console. Emitted as keys, in this order.",
      "type": "array",
      "x-key-reference": "certificate",
      "items": {
        "title": "certificate",
        "type": "object",
        "additionalProperties": false,
        "required": ["pem", "use"],
        "properties": {
          "pem": {"title": "Certificate in PEM", "type": "string", "minLength": 1, "x-widget": "textarea"},
          "use": {
            "title": "Use",
            "type": "string",
            "enum": ["signing", "encryption", "both"],
            "x-widget": "radio"
          }
        }
      }
    },
    "attributePolicy": {
      "title": "Attributes released",
      "description": "Applied only when the core:AttributeLimit filter runs. A row without values releases every value of the attribute.",
      "type": "array",
      "items": {
        "title": "attribute",
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"title": "Name", "type": "string", "minLength": 1},
          "values": {"title": "Allowed values", "description": "One per line.", "$ref": "#/$defs/stringList", "minItems": 1}
        }
      }
    },
    "attributeencodings": {
      "title": "Attribute encodings",
      "description": "Not set for an attribute: string.",
      "type": "array",
      "items": {
        "title": "encoding",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "encoding"],
        "properties": {
          "name": {"title": "Attribute", "type": "string", "minLength": 1},
          "encoding": {"title": "Encoding", "type": "string", "enum": ["string", "base64", "raw"]}
        }
      }
    },
    "sharedkeyAlgorithm": {
      "type": "string",
      "enum": [
        "http://www.w3.org/2009/xmlenc11#aes128-gcm",
        "http://www.w3.org/2009/xmlenc11#aes192-gcm",
        "http://www.w3.org/2009/xmlenc11#aes256-gcm",
        "http://www.w3.org/2001/04/xmlenc#aes128-cbc",
        "http://www.w3.org/2001/04/xmlenc#aes192-cbc",
        "http://www.w3.org/2001/04/xmlenc#aes256-cbc",
        "http://www.w3.org/2001/04/xmlenc#tripledes-cbc"
      ]
    },
    "extra": {
      "title": "Uncataloged options",
      "description": "Merged into the array core receives as they are. Neither validated nor masked; no Secret references.",
      "type": "object",
      "minProperties": 1,
      "x-widget": "textarea"
    }
  }
}
